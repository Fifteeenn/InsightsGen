# Copy this file to .env and paste your key. .env is git-ignored.
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the model. Must be an open-weight model served by Groq.
GROQ_MODEL=openai/gpt-oss-120b
# Optional: smaller model for narration and suggested questions (separate rate-limit quota).
GROQ_NARRATOR_MODEL=qwen/qwen3.8-27b
